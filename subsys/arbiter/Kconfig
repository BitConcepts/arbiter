menuconfig ARBITER
	bool "arbiter deterministic reasoning engine"
	help
	  Enable the arbiter deterministic reasoning and safety-policy
	  engine. arbiter evaluates compiled ARB models against frozen
	  input snapshots to produce deterministic results and
	  explanation traces.

if ARBITER

config ARBITER_LOG_LEVEL
	int "arbiter log level"
	default 3
	range 0 4
	help
	  Log level for arbiter module (0=off, 1=err, 2=wrn, 3=inf, 4=dbg).

# ── Engine Scaling Profiles (REQ-ARCH-029) ──────────────────────

choice ARBITER_PROFILE
	prompt "Engine scaling profile"
	default ARBITER_PROFILE_AUTO
	help
	  Select the engine scaling profile. AUTO detects the best
	  profile from the target CPU family and SRAM size. Override
	  to a fixed profile for explicit resource control.

config ARBITER_PROFILE_AUTO
	bool "Auto-detect from target hardware"
	help
	  Automatically selects nano/micro/standard/full based on
	  the target CPU family and SRAM size.

config ARBITER_PROFILE_NANO
	bool "Nano — 8 facts, 8 rules, no trace, no strings"
	help
	  Minimal profile for Cortex-M0/M0+, AVR, or targets with
	  less than 16 KB SRAM. ~200 bytes RAM.

config ARBITER_PROFILE_MICRO
	bool "Micro — 16 facts, 32 rules, minimal trace"
	help
	  Small profile for Cortex-M3 or targets with 16-64 KB SRAM.
	  ~512 bytes RAM.

config ARBITER_PROFILE_STANDARD
	bool "Standard — 64 facts, full trace (current default)"
	help
	  Standard profile for Cortex-M4/M7 or targets with 64-512 KB
	  SRAM. ~3 KB RAM. This matches the original arbiter defaults.

config ARBITER_PROFILE_FULL
	bool "Full — 256 facts, extended trace, runtime metrics"
	help
	  Full profile for Cortex-A/R, x86, or targets with 512+ KB
	  SRAM. ~12 KB RAM.

endchoice

# Hidden resolved symbols — auto-detection cascade.
# When ARBITER_PROFILE_AUTO is selected, exactly one of these will
# be set to y based on the target's CPU and SRAM Kconfig symbols.
# When a fixed profile is selected, the corresponding RESOLVED_*
# symbol is set directly.

config ARBITER_RESOLVED_NANO
	bool
	default y if ARBITER_PROFILE_NANO
	default y if ARBITER_PROFILE_AUTO && \
		(CPU_CORTEX_M0 || CPU_CORTEX_M0PLUS || CPU_CORTEX_M23)

config ARBITER_RESOLVED_MICRO
	bool
	default y if ARBITER_PROFILE_MICRO
	default y if ARBITER_PROFILE_AUTO && !ARBITER_RESOLVED_NANO && \
		CPU_CORTEX_M3

config ARBITER_RESOLVED_FULL
	bool
	default y if ARBITER_PROFILE_FULL
	default y if ARBITER_PROFILE_AUTO && \
		(CPU_CORTEX_A || CPU_CORTEX_R || ARCH_POSIX)

config ARBITER_RESOLVED_STANDARD
	bool
	default y if ARBITER_PROFILE_STANDARD
	default y if !ARBITER_RESOLVED_NANO && !ARBITER_RESOLVED_MICRO && \
		!ARBITER_RESOLVED_FULL

# Profile-driven limits.

config ARBITER_MAX_FACTS
	int "Maximum number of facts"
	default 8 if ARBITER_RESOLVED_NANO
	default 16 if ARBITER_RESOLVED_MICRO
	default 256 if ARBITER_RESOLVED_FULL
	default 64
	help
	  Maximum number of facts supported by the runtime context.
	  Driven by the selected engine profile.

config ARBITER_MAX_RULES
	int "Maximum number of rules"
	default 8 if ARBITER_RESOLVED_NANO
	default 32 if ARBITER_RESOLVED_MICRO
	default 256 if ARBITER_RESOLVED_FULL
	default 64
	help
	  Maximum number of rules in a compiled model.

config ARBITER_MAX_ACTIONS_PER_EVAL
	int "Maximum actions per evaluation"
	default 4 if ARBITER_RESOLVED_NANO
	default 8 if ARBITER_RESOLVED_MICRO
	default 32 if ARBITER_RESOLVED_FULL
	default 16
	help
	  Maximum number of actions that can be requested per evaluation.

config ARBITER_MAX_TRACE_ENTRIES
	int "Maximum trace entries"
	default 0 if ARBITER_RESOLVED_NANO
	default 4 if ARBITER_RESOLVED_MICRO
	default 256 if ARBITER_RESOLVED_FULL
	default 64
	help
	  Maximum number of trace entries per evaluation.
	  Set to 0 for nano profile (trace disabled).

config ARBITER_MAX_TRACE_INPUTS
	int "Maximum input facts per trace entry"
	default 4 if ARBITER_RESOLVED_NANO || ARBITER_RESOLVED_MICRO
	default 8
	help
	  Maximum number of input fact IDs recorded per trace entry.

config ARBITER_STRINGS
	bool "Include name/explanation strings in model tables"
	default n if ARBITER_RESOLVED_NANO
	default n if ARBITER_RESOLVED_MICRO
	default y
	help
	  When disabled, all name and explanation string pointers in
	  the generated model tables are NULL. Saves .rodata space
	  on resource-constrained targets.

config ARBITER_8BIT_INDEX
	bool
	default y if ARBITER_RESOLVED_NANO || ARBITER_RESOLVED_MICRO
	help
	  Use uint8_t for fact/rule/condition indices instead of
	  uint16_t. Saves RAM and .rodata on small profiles.

config ARBITER_SHELL
	bool "Enable arbiter shell commands"
	depends on SHELL
	default n
	help
	  Provides shell commands: arbiter info, facts, eval, result,
	  trace, explain, model-hash.

config ARBITER_BLOB_LOADER
	bool "Enable binary blob model loading"
	default n
	help
	  Enable loading models from .zrmb binary blob format.
	  Note: strict safety profile prefers generated C tables.

config ARBITER_ACTION_DISPATCHER
	bool "Enable automatic action dispatching"
	default n
	help
	  Enable the action dispatcher which calls registered callbacks
	  after evaluation completes.

config ARBITER_RUNTIME_THREAD
	bool "Enable periodic evaluation thread"
	default n
	help
	  Provide a dedicated thread that periodically takes snapshots,
	  evaluates the model, and optionally dispatches actions.

config ARBITER_THREAD_PRIORITY
	int "Runtime thread priority"
	default 5
	depends on ARBITER_RUNTIME_THREAD

config ARBITER_THREAD_STACK_SIZE
	int "Runtime thread stack size"
	default 2048
	depends on ARBITER_RUNTIME_THREAD

config ARBITER_PERIOD_MS
	int "Evaluation period in milliseconds"
	default 100
	depends on ARBITER_RUNTIME_THREAD

config ARBITER_THREAD_ESSENTIAL
	bool "Mark runtime thread as essential"
	default n
	depends on ARBITER_RUNTIME_THREAD
	help
	  If enabled, a fatal error in the runtime thread will
	  trigger a system fatal error.

config ARBITER_THREAD_USERSPACE
	bool "Run runtime thread in userspace"
	depends on ARBITER_RUNTIME_THREAD && USERSPACE
	default n

config ARBITER_USERSPACE
	bool "Enable userspace support"
	depends on USERSPACE
	default n
	help
	  Place arbiter data structures in a dedicated memory domain
	  accessible only to the arbiter thread.

config ARBITER_SAFETY_STRICT
	bool "Enable strict safety profile"
	default n
	help
	  Enforces strict safety constraints: no heap after init,
	  no floating point, no dynamic loading, bounded everything.
	  Shell is automatically disabled in this profile.

config ARBITER_TRACE
	bool "Enable evaluation tracing"
	default y
	help
	  Record a bounded explanation trace for each evaluation.

config ARBITER_ASSERTS
	bool "Enable runtime assertions"
	default y
	help
	  Enable __ASSERT checks in arbiter internals. Useful for
	  development; strict production should not depend on these.

config ARBITER_WATCHDOG
	bool "Enable watchdog integration"
	depends on WATCHDOG
	default n
	help
	  Feed a watchdog channel after each successful evaluation.
	  On evaluation failure or timeout, the watchdog is not fed,
	  allowing it to trigger a reset.

# ── HW Acceleration (REQ-ARCH-030) ───────────────────────────

config ARBITER_HW_ACCEL
	bool "Enable HW-accelerated expression evaluation"
	default n
	help
	  Use platform-optimized intrinsics for batch expression
	  evaluation. On ARM Cortex-M4+ this uses CMSIS-DSP
	  saturating arithmetic (__QADD, __QSUB, __SMMUL). On
	  RISC-V with P-extension this uses packed SIMD intrinsics.
	  When disabled, the standard scalar C path is used with
	  zero overhead.

# ── Assembly Hot Paths (REQ-ARCH-031) ────────────────────────

config ARBITER_ASM_OPT
	bool "Enable hand-tuned assembly hot paths"
	depends on ARBITER_HW_ACCEL
	default n
	help
	  Provide hand-tuned assembly for the innermost hot loops
	  (expression batch eval, condition scan). Only available
	  on supported CPU families. Assembly is only added when
	  benchmarks demonstrate >15%% speedup over the C path.

# ── FPGA Offload (REQ-ARCH-032) ─────────────────────────────

config ARBITER_FPGA_OFFLOAD
	bool "Enable FPGA offload interface (future)"
	default n
	help
	  Enable the FPGA hardware offload interface. This provides
	  the ARBITER_hw_offload_ops struct for board-level drivers
	  to offload condition evaluation and expression execution
	  to FPGA fabric. No implementation is shipped in v1.

# ── Event-Driven Evaluation (REQ-ARCH-036) ───────────────

config ARBITER_EVENT_DRIVEN
	bool "Enable event-driven evaluation"
	default n
	help
	  Watch specific facts for changes and evaluate only when a
	  watched fact has been modified.  Uses static bitmasks —
	  no dynamic allocation.

# ── Multi-Model Composition (REQ-ARCH-037) ───────────────

config ARBITER_COMPOSE
	bool "Enable multi-model composition"
	default n
	help
	  Share facts between multiple models via a common fact bus.
	  Each model is attached with a mapping table; the bus
	  synchronizes and evaluates all models in order.

config ARBITER_MAX_MODELS
	int "Maximum number of attached models"
	default 4
	depends on ARBITER_COMPOSE
	help
	  Maximum number of model contexts that can be attached to a
	  single fact bus.

# ── State Machine Support (REQ-ARCH-039) ─────────────────

config ARBITER_STATE_MACHINE
	bool "Enable state machine support"
	default n
	help
	  Add explicit state machine evaluation with guarded
	  transitions, priorities, and on_enter/on_exit actions.

config ARBITER_MAX_STATES
	int "Maximum number of states"
	default 16
	depends on ARBITER_STATE_MACHINE
	help
	  Maximum number of state definitions per model.

config ARBITER_MAX_TRANSITIONS
	int "Maximum number of transitions"
	default 32
	depends on ARBITER_STATE_MACHINE
	help
	  Maximum number of transition definitions per model.

# ── Remote Trace Export (REQ-ARCH-038) ───────────────────

config ARBITER_TRACE_EXPORT
	bool "Enable remote trace export"
	default n
	help
	  Serialize evaluation trace entries into binary frames and
	  send them over a pluggable transport (UART, network, etc.)
	  for remote analysis and debugging.

# ── Zbus Integration (REQ-ARCH-042) ─────────────────────

config ARBITER_ZBUS
	bool "Enable zbus integration"
	depends on ZBUS
	default n
	help
	  Publish evaluation results and subscribe to fact updates
	  via Zephyr zbus channels.

# ── Grafana Metrics (REQ-ARCH-042) ──────────────────────

config ARBITER_METRICS
	bool "Enable runtime metrics (Zephyr stats)"
	depends on STATS
	default n
	help
	  Expose evaluation metrics (count, latency, faults, etc.)
	  through the Zephyr stats subsystem for Grafana or other
	  monitoring dashboards.

endif # ARBITER
